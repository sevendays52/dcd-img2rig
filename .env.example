# Web Studio Server
IMG2RIG_HOST=127.0.0.1
IMG2RIG_PORT=8765

# Optional custom directories (defaults to repository root / ./outputs / ./uploads)
# IMG2RIG_DATA_DIR=.
# IMG2RIG_OUTPUTS_DIR=./outputs
# IMG2RIG_UPLOADS_DIR=./uploads

# Idol model & encoders
# Leave IDOL_WEIGHTS empty to auto-download/use Hugging Face cache (speridlabs/idol)
# IDOL_WEIGHTS=
# IDOL_ENCODERS_DIR=./encoders

# Compute device: cuda | mps | cpu (leave empty for auto-detect)
# IDOL_DEVICE=
# IDOL_DINOV3_DTYPE=bf16
# IDOL_COMPILE=0

# Optional explicit Blender executable path
# BLENDER_BIN=

# Hugging Face token (needed if downloading gated encoders from Hub)
# HF_TOKEN=
